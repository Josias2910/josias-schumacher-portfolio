---
// Componente de diseño puro: recibe imagen y textos por props,
// la animación vive aparte en heroAnimations.ts
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  backgroundImage: ImageMetadata;
  backgroundAlt: string;
  titleLines: [string, string];
  name: string;
}

const { backgroundImage, backgroundAlt, titleLines, name } = Astro.props;
---

<section data-hero class="relative -mt-16 h-[85vh] min-h-[600px] w-full overflow-hidden sm:h-screen">
  <!-- Foto de fondo, full-bleed -->
  <Image
    src={backgroundImage}
    alt={backgroundAlt}
    class="hero-background absolute inset-0 z-0 h-full w-full object-cover"
    sizes="100vw"
  />

  <!-- Scrim oscuro para que el título sea legible sobre la foto -->
  <div
    class="absolute inset-y-0 left-0 z-0 w-full bg-gradient-to-r from-black/55 via-black/25 to-transparent sm:w-2/3"
    aria-hidden="true"
  ></div>

   <div class="hero-whiteout pointer-events-none absolute inset-0 z-10 bg-black opacity-0" aria-hidden="true"></div>

  <!-- Título "SOFTWARE DEVELOPER": cada línea rompe sus letras en spans
       individuales (.hero-letter) para animar la entrada letra por letra.
       .hero-title-line-inner sigue existiendo para el parallax de mouse
       independiente de la línea completa (.hero-title-line, usada para
       la flotación orgánica post-entrada). -->
 <div class="absolute left-6 top-[25%] z-20 sm:left-10 lg:left-56">
    <h1 class="hero-title relative font-sans text-[clamp(2.75rem,7vw,7rem)] font-medium uppercase leading-[0.85] tracking-tight text-white">
      {titleLines.map((line) => (
        <span class="hero-title-line block">
          <span class="hero-title-line-inner inline-flex">
            {line.split("").map((char) => (
              <span class="hero-letter inline-block">{char === " " ? "\u00A0" : char}</span>
            ))}
          </span>
        </span>
      ))}
    </h1>

    <!-- Nombre: oculto por defecto, aparece con una entrada tipo "logo
         reveal" (letras volando desde distintas direcciones + overshoot
         elástico) solo al pasar el mouse por el título. Pegado justo
         debajo del título, heredando su misma alineación izquierda. -->
    <div
  class="hero-name-reveal pointer-events-none mt-3 flex gap-1 opacity-0 sm:mt-4 sm:gap-2"
  aria-hidden="true"
>
      {name.split("").map((char) => (
        <span class="hero-name-letter inline-block font-sans text-[clamp(1rem,2.2vw,1.5rem)] font-semibold uppercase tracking-[0.3em] text-white/90">
          {char === " " ? "\u00A0" : char}
        </span>
      ))}
    </div>
  </div>
</section>

<script>
  // Engancha las animaciones GSAP a esta instancia del Hero,
  // pero solo después de que termine la animación de entrada
  import { initHeroAnimations } from "../../animations/heroAnimations";

  const hero = document.querySelector<HTMLElement>("[data-hero]");

  if (hero) {
    window.addEventListener("entrance:complete", () => initHeroAnimations(hero), { once: true });
  }
</script>